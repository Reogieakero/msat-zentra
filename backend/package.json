{
  "name": "zentra-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-anecdotal-assets.mjs",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:topup50": "tsx prisma/seed-topup-50.ts",
    "prisma:count": "tsx prisma/count-transactions.ts",
    "prisma:section20": "tsx prisma/seed-section-20.ts",
    "prisma:gradebook": "tsx prisma/seed-gradebook-full.ts",
    "prisma:gradebook-gaps": "tsx prisma/seed-gradebook-fill-gaps.ts",
    "prisma:gradebook-audit": "tsx prisma/audit-gradebook-coverage.ts",
    "prisma:seed100": "tsx prisma/seed-100-topup.ts",
    "prisma:seed100-fix": "tsx prisma/fix-seed100-gaps.ts",
    "test": "vitest run --testTimeout=15000",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@supabase/supabase-js": "^2.112.4",
    "@types/argon2": "^0.14.1",
    "@upstash/redis": "^1.38.3",
    "argon2": "^0.45.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "pg": "^8.23.0",
    "pino": "^9.6.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "prisma": "^7.10.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
