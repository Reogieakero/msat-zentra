// Zentra backend — Prisma schema (30 tables, grounded from PLAN.md §3)
// RLS policies live in ./migrations SQL, not here.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  student
  parent
  subject_teacher
  adviser
  nurse
  adm_coordinator
  guidance_counselor
  record_keeper
  registrar
  principal
}

enum UserStatus {
  pending
  active
  suspended
}

enum GradeLevel {
  G7
  G8
  G9
  G10
  G11
  G12
}

enum RiskLevel {
  Low
  Moderate
  High
}

enum Confidentiality {
  restricted
  confidential
}

enum AttendanceStatus {
  present
  absent
  late
  excused
}

enum Session {
  AM
  PM
}

enum ComponentType {
  WRITTEN_WORK
  PERFORMANCE_TASK
  EXAM
}

enum LockStatus {
  unlocked
  locked
  adviser_approved
}

enum Remarks {
  Passed
  Failed
}

enum ReferralTarget {
  nurse
  guidance_counselor
  adm_coordinator
  principal
}

enum AnecdotalCategory {
  behavioral
  bullying
  academic
  attendance
  health
}

enum ReferralStatus {
  pending
  in_progress
  resolved
  escalated
  info_requested
  dismissed
  follow_up
}

enum GradeFlagReason {
  wrong_score
  missing_assessment
  transmutation_error
  late_submission
  other
}

enum GradeFlagStatus {
  open
  resolved
  escalated
}

enum ApprovalStatus {
  pending
  approved
  rejected
  modified
}

enum OutcomeStatus {
  ongoing
  resolved
  unresolved
}

enum AdmEligibility {
  pending
  eligible
  ineligible
}
enum AdmStage {
  anecdotal
  consultation
  meeting_parents
  home_visitation
  certification
  principal_approval
  enrollment_monitoring
  completion
}
enum AdmFormType {
  REFERRAL_FORM
  ANECDOTAL_REPORT
  CERTIFICATION
  MINUTES_OF_MEETING
  HV_FORM
}


enum Sf10Source {
  auto_populated
  ocr_upload
  manual
}

enum Sf10Status {
  attach
  available
  released
}

enum ActionType {
  sf10_update
  grade_lock
  grade_unlock
  anecdotal_edit
  health_record_edit
  home_visitation_edit
  adm_edit
  referral_status_change
  referral_accepted
  referral_escalated
  referral_reassigned
  referral_note_added
  referral_follow_up
  referral_dismissed
  referral_referred_specialist
  referral_adm_initiated
  session_scheduled
  session_completed
  session_cancelled
  session_rescheduled
  session_document_added
  intervention_approval
  intervention_assigned
  intervention_outcome
  account_approval
  role_change
  adm_principal_approve
  school_year_create
  term_create
  school_year_set_active
  school_year_edit
  honor_roll_mark_awarded
  report_refresh
  principal_profile_change
  principal_password_change
  sf10_access_grant
  sf10_access_deny
  grade_flag_raise
  grade_flag_resolve
  attendance_submit
  create
  update
  delete
}

enum AccessRequestStatus {
  pending
  approved
  denied
}

enum NotifChannel {
  web
  mobile
  email
}

// ---------------------------------------------------------------------------
// 3.1 Identity & accounts
// ---------------------------------------------------------------------------
model User {
  id             String      @id @default(uuid())
  email          String      @unique
  passwordHash   String
  role           Role
  fullName       String
  contactNumber  String?
  lrn            String? // claimed LRN at sign-up; verified against StudentRoster at approval
  status         UserStatus  @default(pending)
  approvedBy     String?
  approvedAt     DateTime?
  createdAt      DateTime    @default(now())

  studentProfile      StudentProfile?
  parentProfile       ParentProfile?
  staffProfile        StaffProfile?
  anecdotalRecords    AnecdotalRecord[]      @relation("ObserverAnecdotals")
  anecdotalFolders    AnecdotalFolder[]      @relation("FolderOwner")
  anecdotalFollowups  AnecdotalRecordFollowup[]
  referralsMade       Referral[]             @relation("ReferredBy")
  sessionsCreated     CounselingSession[]    @relation("SessionCreator")
  sessionAttachments  ClinicSessionAttachment[] @relation("SessionAttachmentUploader")
  assignedInterventions Intervention[]         @relation("InterventionAssignee")
  healthRecords       HealthRecord[]
  homeVisitations     HomeVisitationRecord[]
  admProfilesPrepared AdmLearnerProfile[]    @relation("AdmPreparedBy")
  admProfilesApproved AdmLearnerProfile[]    @relation("AdmApprovedBy")
  admMeetings         AdmParentMeeting[]
  admMeetingInvites   AdmMeetingInvitee[]
  admMeetingAttachments AdmMeetingAttachment[]
  admModules          AdmModule[]
  admDevicesIssued    AdmDevice[]            @relation("DeviceIssuedBy")
  admFormsUploaded    AdmForm[]
  sf10Records         Sf10Record[]           @relation("Sf10VerifiedBy")
  sf10Validated       Sf10Record[]           @relation("Sf10ValidatedBy")
  sf10Versions        Sf10RecordVersion[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  refreshTokens       RefreshToken[]
  sectionsAdvised     Section[]              @relation("AdviserSection")
  sf10AccessRequests  AdviserSf10AccessRequest[] @relation("Sf10AccessAdviser")
  sf10AccessDecided   AdviserSf10AccessRequest[] @relation("Sf10AccessDecidedBy")
  teacherAssignments  TeacherSubjectAssignment[]
  submittedTimetables SectionTimetableEntry[] @relation("TimetableSubmitted")
  reviewedTimetables  SectionTimetableEntry[] @relation("TimetableReviewed")
  teacherName         TeacherName?
  termGrants          TeacherTermGrant[]
  archivedAdvisees    AdviserArchivedStudent[]
  gradeFlagsRaised    GradeFlag[]            @relation("FlagRaisedBy")
  gradeFlagsOwned     GradeFlag[]            @relation("FlagOwner")
  gradeFlagsResolved  GradeFlag[]            @relation("FlagResolvedBy")
}

model StudentProfile {
  userId       String     @id
  lrn          String     @unique
  gradeLevel   GradeLevel
  sectionId    String?
  birthdate    DateTime?
  gender       String?
  address      String?
  photoUrl     String?
  riskCount    Int        @default(0)
  riskLevel    RiskLevel  @default(Low)
  academicFlag Boolean @default(false)
  attendanceFlag Boolean @default(false)
  behavioralFlag Boolean @default(false)
  createdAt    DateTime   @default(now())

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  section           Section?           @relation(fields: [sectionId], references: [id])
  attendanceRecords AttendanceRecord[]
  studentGrades     StudentGrade[]
  finalGrades       FinalGrade[]
  anecdotalRecords  AnecdotalRecord[]
  referrals         Referral[]         @relation("StudentReferrals")
  interventions     Intervention[]
  healthRecords     HealthRecord[]
  homeVisitations   HomeVisitationRecord[]
  admProfiles       AdmLearnerProfile[]
  parentLinks       ParentStudentLink[] @relation("PSL_student")
  riskSnapshots     RiskSnapshot[]
  sf10Records       Sf10Record[]
  gradeFlags        GradeFlag[]
}

model ParentProfile {
  userId     String   @id
  address    String?
  occupation String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  childLinks ParentStudentLink[] @relation("PSL_parent")
}

model ParentStudentLink {
  id            String   @id @default(uuid())
  parentId      String
  studentId     String
  relationship  String
  approvedBy    String?
  createdAt     DateTime @default(now())
  parent        ParentProfile  @relation("PSL_parent", fields: [parentId], references: [userId], onDelete: Cascade)
  student       StudentProfile @relation("PSL_student", fields: [studentId], references: [userId], onDelete: Cascade)
  @@unique([parentId, studentId])
}

model StaffProfile {
  userId       String  @id
  employeeId   String  @unique
  department   String?
  isAdviser    Boolean @default(false)
  // Master Teacher designation (grades 7–10 only). Self-declared by the
  // teacher from Settings; the update endpoint enforces the grade band.
  isMasterTeacher Boolean @default(false)
  handledGradeLevels GradeLevel[]
  // The teacher's one reusable drawn signature (PNG data URL), stamped onto
  // records via POST /api/anecdotal/:id/apply-signature.
  signatureImageUrl String?
  // Profile photo (PNG/JPEG data URL) shown across the teacher workspace.
  photoUrl String?
  // Workspace palette (hex, e.g. "#7c3aed") applied site-wide to cards,
  // buttons, and accents for this teacher. Null = theme default.
  primaryColor String?
  secondaryColor String?
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// 3.2 Academic structure
// ---------------------------------------------------------------------------
model SchoolYear {
  id         String   @id @default(uuid())
  name       String
  startDate  DateTime
  endDate    DateTime
  isActive   Boolean  @default(false)
  createdBy  String
  createdAt  DateTime @default(now())
  terms      Term[]
  sections   Section[]
  rosterEntries StudentRoster[]
  @@index([isActive])
}

model Term {
  id            String      @id @default(uuid())
  schoolYearId String
  termNumber    Int // 1,2,3
  startDate     DateTime?
  endDate       DateTime?
  schoolYear    SchoolYear  @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  gradeComponents GradeComponent[]
  finalGrades   FinalGrade[]
  attendanceRecords AttendanceRecord[]
  anecdotalRecords AnecdotalRecord[]
  referrals     Referral[]
  interventions Intervention[]
  healthRecords HealthRecord[]
  homeVisitations HomeVisitationRecord[]
  admProfiles   AdmLearnerProfile[]
  riskSnapshots RiskSnapshot[]
  reportSnapshots ReportSnapshot[]
  teacherAssignments TeacherSubjectAssignment[]
  gradeFlags GradeFlag[]
  scheduleConfigs ScheduleConfig[]
  timetableEntries SectionTimetableEntry[]
  termGrants TeacherTermGrant[]
  @@unique([schoolYearId, termNumber])
}

model Section {
  id           String     @id @default(uuid())
  name         String
  gradeLevel   GradeLevel
  schoolYearId String
  adviserId    String?
  // Free-text advisory listing (principal-managed). Written whenever a name
  // is assigned; the adviserId link is only set when the teacher claims the
  // section with its advisory code, so listing never blocks on accounts.
  adviserLabel String?
  // Advisory claim code (principal-managed, e.g. ADV-7K2Q9). Minted on every
  // assignment, consumed (cleared) when the teacher claims with it, cleared
  // when the adviser is removed. Never exposed to teacher-role routes — the
  // principal shares it out-of-band and the teacher enters it to claim.
  adviserCode String? @unique
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  adviser      User?      @relation("AdviserSection", fields: [adviserId], references: [id])
  students     StudentProfile[]
  attendanceRecords AttendanceRecord[]
  anecdotalRecords AnecdotalRecord[]
  teacherAssignments TeacherSubjectAssignment[]
  gradeFlags GradeFlag[]
  timetableEntries SectionTimetableEntry[]
  rosterEntries StudentRoster[]
  sf10AccessRequests AdviserSf10AccessRequest[]
  @@index([schoolYearId])
  @@index([gradeLevel])
  @@index([adviserId])
}

// Decoupled enrollment roster: a student enrolled in a section for a school year,
// independent of whether they have a login account yet. Used by the registrar
// "Accounts Breakdown" to report enrolled-but-not-yet-registered students
// ("no account") by matching roster LRN against student_profiles.
model StudentRoster {
  id           String   @id @default(uuid())
  lrn          String
  fullName     String
  gradeLevel   GradeLevel
  sectionId    String
  schoolYearId String
  riskCount    Int        @default(0)
  riskLevel    RiskLevel  @default(Low)
  academicFlag Boolean @default(false)
  attendanceFlag Boolean @default(false)
  behavioralFlag Boolean @default(false)
  section      Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  attendanceRecords AttendanceRecord[]
  anecdotalRecords AnecdotalRecord[]
  referrals Referral[]
  studentGrades StudentGrade[]
  finalGrades FinalGrade[]
  riskSnapshots RiskSnapshot[]
  interventions Intervention[]
  @@unique([lrn, schoolYearId])
  @@index([gradeLevel])
  @@index([sectionId])
  @@index([schoolYearId])
  @@index([schoolYearId, riskLevel])
}

enum SubjectCategory {
  CORE
  ELECTIVE
}

model Subject {
  id         String          @id @default(uuid())
  name       String
  code       String
  gradeLevel GradeLevel
  category   SubjectCategory @default(CORE)
  gradeComponents GradeComponent[]
  finalGrades FinalGrade[]
  assignments TeacherSubjectAssignment[]
  gradeFlags GradeFlag[]
  timetableEntries SectionTimetableEntry[]
  attendanceRecords AttendanceRecord[]
  @@unique([code, gradeLevel])
}

model TeacherSubjectAssignment {
  id         String   @id @default(uuid())
  teacherId  String
  subjectId  String
  sectionId  String
  termId     String
  teacher    User     @relation(fields: [teacherId], references: [id])
  subject    Subject  @relation(fields: [subjectId], references: [id])
  section    Section  @relation(fields: [sectionId], references: [id])
  term       Term     @relation(fields: [termId], references: [id])
  attendanceRecords AttendanceRecord[]
  @@unique([teacherId, subjectId, sectionId, termId])
}

// Schedule review workflow: master-teacher fills are DRAFTS — never live —
// until sent (SUBMITTED) and principal-approved (APPROVED, the only status
// that materializes gradebook assignments). Reject returns rows to DRAFT
// with the principal's note for revision.
enum TimetableStatus {
  DRAFT
  SUBMITTED
  APPROVED
}
// ScheduleConfig stores the day shape per term (start time, period length,
// lunch + recess placement). One row per term; the setup view falls back to
// app defaults when no row exists yet.
model ScheduleConfig {
  id            String @id @default(uuid())
  termId        String @unique
  startTime     String @default("07:30")
  periodMins    Int    @default(60)
  lunchAfter    Int    @default(4)
  lunchMins     Int    @default(90)
  recessAmOn    Boolean @default(false)
  recessAmAfter Int    @default(2)
  recessAmMins  Int    @default(15)
  recessPmOn    Boolean @default(false)
  recessPmAfter Int    @default(6)
  recessPmMins  Int    @default(15)
  term          Term   @relation(fields: [termId], references: [id], onDelete: Cascade)
}

// One filled timetable cell: a subject placed in a section's weekly template
// for a term. day 1=Mon..5=Fri, period is the 0-based period number (stable
// when durations change). A slot holds at most one subject.
model SectionTimetableEntry {
  id            String  @id @default(uuid())
  sectionId     String
  subjectId     String
  termId        String
  day           Int
  period        Int
  // Display name running this slot — a plain catalog name, not a login.
  // Nullable so rows created before names existed stay valid.
  teacherNameId String?
  status        TimetableStatus @default(DRAFT)
  submittedBy   String?
  submittedAt   DateTime?
  reviewedBy    String?
  reviewedAt    DateTime?
  reviewNote    String?
  section       Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject       Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  term          Term         @relation(fields: [termId], references: [id], onDelete: Cascade)
  teacherName   TeacherName? @relation(fields: [teacherNameId], references: [id], onDelete: Cascade)
  submitter     User?        @relation("TimetableSubmitted", fields: [submittedBy], references: [id], onDelete: SetNull)
  reviewer      User?        @relation("TimetableReviewed", fields: [reviewedBy], references: [id], onDelete: SetNull)
  @@unique([sectionId, termId, day, period])
  @@index([sectionId, termId])
}

// Plain display-name catalog for timetable slots. The master types each name
// once in Add Teachers, then picks from the list — no accounts, emails, or
// passwords are involved anywhere. A teacher links their own login to their
// catalog row by entering its code on teacher/classes, attaching the row's
// subjects and timeslots to their personal calendar.
model TeacherName {
  id      String @id @default(uuid())
  name    String @unique
  // Short token code (e.g. MS-101), visible wherever names are listed so the
  // master can reference teachers. Nullable: rows predating codes stay valid.
  code    String? @unique
  // Login that claimed this row via its code. Nullable + unique: unclaimed
  // rows stay valid, and one login holds at most one row.
  userId  String? @unique
  // Attendance code verified once — the attendance page stops asking until
  // the row is unlinked. Cleared together with userId on release.
  // LEGACY (global): superseded by per-term TeacherTermGrant rows. Kept for
  // history; the workspace reads grants, never this column.
  attendanceVerifiedAt DateTime?
  entries SectionTimetableEntry[]
  termGrants TeacherTermGrant[]
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// Per-term workspace verification ("auth" gate per term). A Term 1 link or
// unlock never opens another term: each term needs its own grant row —
// either the adviser tapping through for that term (`via: "adviser"`) or the
// teacher entering their (same) link code again (`via: "code"` +
// attendanceVerifiedAt). Gated reads/writes join on (userId, termId).
model TeacherTermGrant {
  id                   String      @id @default(uuid())
  userId               String
  termId               String
  // How this term was entered: adviser tap-through vs code verification.
  via                  String
  teacherNameId        String?
  attendanceVerifiedAt DateTime?
  createdAt            DateTime    @default(now())
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  term                 Term        @relation(fields: [termId], references: [id], onDelete: Cascade)
  teacherName          TeacherName? @relation(fields: [teacherNameId], references: [id], onDelete: SetNull)

  @@unique([userId, termId])
  @@index([termId])
}

// Adviser-scoped soft delete for advisory students. One row hides a student
// (registered profile OR roster enlistment) from one adviser's list only —
// grades, attendance, anecdotal records, and referrals are never touched, so
// restoring brings the full record history back. Exactly one of studentId /
// rosterId is set.
model AdviserArchivedStudent {
  id         String   @id @default(uuid())
  teacherId  String
  studentId  String?
  rosterId   String?
  createdAt  DateTime @default(now())
  teacher    User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, studentId])
  @@unique([teacherId, rosterId])
  @@index([teacherId])
}

// ---------------------------------------------------------------------------
// 3.3 Grading
// ---------------------------------------------------------------------------
model GradeComponent {
  id               String        @id @default(uuid())
  subjectId        String
  termId           String
  componentType    ComponentType
  weightPercentage Int
  subject          Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  term             Term          @relation(fields: [termId], references: [id], onDelete: Cascade)
  assessments      Assessment[]
  @@unique([subjectId, termId, componentType])
}

model Assessment {
  id              String   @id @default(uuid())
  gradeComponentId String
  title           String
  maxScore        Float
  dateGiven       DateTime
  createdBy       String
  createdAt       DateTime @default(now())
  gradeComponent  GradeComponent  @relation(fields: [gradeComponentId], references: [id], onDelete: Cascade)
  studentGrades   StudentGrade[]
}

model StudentGrade {
  id               String     @id @default(uuid())
  assessmentId     String
  // Exactly one of studentId (registered profile) / rosterId (enlisted, no
  // account yet) is set — enforced by a CHECK constraint in the migration.
  studentId        String?
  rosterId         String?
  rawScore         Float
  percentageScore  Float // computed
  assessment       Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student          StudentProfile? @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  roster           StudentRoster? @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  @@unique([assessmentId, studentId])
  @@unique([assessmentId, rosterId])
  @@index([rosterId])
}

model FinalGrade {
  id                String       @id @default(uuid())
  // Exactly one of studentId (registered profile) / rosterId (enlisted, no
  // account yet) is set — enforced by a CHECK constraint in the migration.
  studentId         String?
  rosterId          String?
  subjectId         String
  termId            String
  computedAverage   Float?
  transmutedGrade   Float?
  remarks           Remarks?
  lockStatus        LockStatus   @default(unlocked)
  lockedBy          String?
  lockedAt          DateTime?
  adviserApprovedBy String?
  adviserApprovedAt DateTime?
  finalizedBy       String?
  finalizedAt       DateTime?
  student           StudentProfile? @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  roster            StudentRoster? @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  subject           Subject        @relation(fields: [subjectId], references: [id])
  term              Term           @relation(fields: [termId], references: [id])
  @@unique([studentId, subjectId, termId])
  @@unique([rosterId, subjectId, termId])
  @@index([rosterId])
  @@index([studentId, termId])
  @@index([termId])
}

// Teacher-raised flags on student grades. Any teacher may raise a flag on any
// grade; only the gradebook owner (resolved from TeacherSubjectAssignment)
// may resolve. Overdue open flags flip to escalated for the Principal
// dashboard. Editing the underlying grade never auto-resolves a flag.
model GradeFlag {
  id             String          @id @default(uuid())
  studentId      String
  subjectId      String
  sectionId      String
  termId         String
  reason         GradeFlagReason
  note           String?
  status         GradeFlagStatus @default(open)
  raisedBy       String
  ownerId        String?
  resolvedBy     String?
  resolvedAt     DateTime?
  resolutionNote String?
  escalatedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  student        StudentProfile  @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  subject        Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  section        Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  term           Term            @relation(fields: [termId], references: [id], onDelete: Cascade)
  raisedByUser   User            @relation("FlagRaisedBy", fields: [raisedBy], references: [id], onDelete: Cascade)
  owner          User?           @relation("FlagOwner", fields: [ownerId], references: [id])
  resolvedByUser User?           @relation("FlagResolvedBy", fields: [resolvedBy], references: [id])
  @@index([status, ownerId])
  @@index([raisedBy])
  @@index([studentId])
  @@index([status])
  // Flag queue reads scope to the active term.
  @@index([termId, status, ownerId])
}

// ---------------------------------------------------------------------------
// 3.4 Attendance
// ---------------------------------------------------------------------------
// Per-subject attendance (AM/PM → subject migration).
// - New writes REQUIRE subjectId (+ slot for same-subject repeats in one day).
// - Legacy AM/PM rows keep subjectId NULL and remain readable; the authoritative
//   archive copy lives in AttendanceRecordLegacy (see migration
//   20260926000000_attendance_subject_support). Do NOT backfill subjectId for
//   legacy rows — that would invent history.
// - session is retained (frozen) for legacy reads only; new writes set it to AM
//   as a placeholder until the Phase-7 cleanup drops the column.
model AttendanceRecord {
  id         String           @id @default(uuid())
  // Exactly one of studentId (registered profile) / rosterId (enlisted, no
  // account yet) is set — enforced by a CHECK constraint in the migration.
  studentId  String?
  rosterId   String?
  sectionId  String
  date       DateTime
  session    Session          @default(AM)
  status     AttendanceStatus
  recordedBy String
  termId     String
  // Per-subject fields. NULL = legacy AM/PM row (pre-migration).
  subjectId  String?
  assignmentId String?
  // 1-based occurrence of the same subject for the same student on the same
  // date (double periods). Part of the subject-era unique key.
  slot       Int              @default(1)
  student    StudentProfile?  @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  roster     StudentRoster?   @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  section    Section          @relation(fields: [sectionId], references: [id])
  term       Term             @relation(fields: [termId], references: [id])
  subject    Subject?         @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  assignment TeacherSubjectAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  // Legacy AM/PM uniqueness lives as partial indexes in migration
  // 20260927190000 (WHERE subjectId IS NULL) so subject-era rows for
  // several subjects can share one student-day.
  @@unique([studentId, subjectId, date, slot])
  @@unique([rosterId, subjectId, date, slot])
  @@index([rosterId])
  @@index([studentId, termId])
  @@index([sectionId, termId])
  @@index([subjectId, termId])
  @@index([sectionId, subjectId, termId])
  @@index([assignmentId])
}

// Frozen archive of pre-migration AM/PM rows, written once by migration
// 20260926000000_attendance_subject_support. Read-only via
// GET /api/attendance/legacy/* — never written by application code.
model AttendanceRecordLegacy {
  id         String           @id
  studentId  String?
  rosterId   String?
  sectionId  String
  date       DateTime
  session    Session
  status     AttendanceStatus
  recordedBy String
  termId     String
  archivedAt DateTime         @default(now())
  @@index([sectionId, termId])
  @@index([studentId, termId])
  @@index([rosterId])
}

// ---------------------------------------------------------------------------
// 3.5 Behavioral & intervention
// ---------------------------------------------------------------------------
model AnecdotalRecord {
  id                     String          @id @default(uuid())
  // Exactly one of studentId (registered profile) / rosterId (enlisted, no
  // account yet) is set — enforced by a CHECK constraint in the migration.
  studentId              String?
  rosterId               String?
  observerId             String
  sectionId              String
  observationDatetime    DateTime
  descriptionOfIncident  String
  descriptionOfLocation  String?
  notesRecommendationsActions String?
  classPerformance       String?
  attendanceSummary      String?
  attachmentUrl          String?
  termId                 String
  category               AnecdotalCategory @default(behavioral)
  confidentialityLevel   Confidentiality  @default(restricted)
  folderId               String?
  // Per-record adviser sign-off: drawn signature PNG in Storage, applied
  // once via POST /:id/sign. Null trio = unsigned (blank line on the form).
  signedBy               String?
  signedAt               DateTime?
  signatureImageUrl      String?
  student                StudentProfile? @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  roster                 StudentRoster?  @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  observer               User            @relation("ObserverAnecdotals", fields: [observerId], references: [id])
  section                Section         @relation(fields: [sectionId], references: [id])
  term                   Term            @relation(fields: [termId], references: [id])
  folder                 AnecdotalFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  followups              AnecdotalRecordFollowup[]
  referrals              Referral[]      @relation("AnecdotalReferral")
  @@index([folderId])
  @@index([observationDatetime])
  @@index([studentId, termId])
  @@index([rosterId, termId])
  @@index([sectionId, termId])
  // Anecdotal list reads filter by term + section ordered by recency.
  @@index([termId, sectionId, observationDatetime])
  @@index([observerId, termId])
}

// Teacher-owned collections of filed anecdotal records. Folders organize
// records only (chat threads stay local) and are always scoped to the
// owning teacher — every folder endpoint filters by ownerId.
model AnecdotalFolder {
  id        String   @id @default(uuid())
  ownerId   String
  name      String
  createdAt DateTime @default(now())
  owner     User     @relation("FolderOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  records   AnecdotalRecord[]
  @@index([ownerId])
}

model AnecdotalRecordFollowup {
  id                String          @id @default(uuid())
  anecdotalRecordId String
  followupBy        String
  followupDate      DateTime
  notes             String
  anecdotalRecord   AnecdotalRecord @relation(fields: [anecdotalRecordId], references: [id], onDelete: Cascade)
  followupUser      User            @relation(fields: [followupBy], references: [id])
}

model Referral {
  id                String          @id @default(uuid())
  anecdotalRecordId String
  referredToRole    ReferralTarget
  referredBy        String
  reason            String
  // ADM consultation reviewer picked by the teacher ("Who should receive
  // this case?" — nurse | guidance_counselor | lrpc). Only the selected
  // reviewer may act on the case at the consultation stage; everyone else
  // sees it read-only. Null = legacy / non-ADM routing.
  consultReviewer   String?
  consultReviewedAt DateTime?
  // Nurse ADM flow: the referral form (GCForm-03 fill-up) must be completed
  // on the dedicated form page before the case can be forwarded to the ADM
  // coordinator. Confirming the form sets this flag; forwarding requires it
  // — a case never moves to in_progress without an explicit forward click.
  referralFormReady Boolean @default(false)
  status            ReferralStatus  @default(pending)
  notes             String?
  escalationReason  String?
  followUpDate      DateTime?
  escalatedTo       String?
  // Guidance intake (filled when the case is accepted): priority triage,
  // first impressions, and when the counselor took the case.
  priority          String?
  intakeNotes       String?
  acceptedAt        DateTime?
  // Strict close-out: a closing summary plus when it was resolved.
  resolutionSummary String?
  resolvedAt        DateTime?
  // Exactly one of studentId (registered profile) / rosterId (enlisted, no
  // account yet) is set — enforced by a CHECK constraint in the migration.
  studentId         String?
  rosterId          String?
  termId            String
  anecdotalRecord   AnecdotalRecord @relation("AnecdotalReferral", fields: [anecdotalRecordId], references: [id], onDelete: Cascade)
  referredByUser    User            @relation("ReferredBy", fields: [referredBy], references: [id], onDelete: Cascade)
  student           StudentProfile? @relation("StudentReferrals", fields: [studentId], references: [userId], onDelete: Cascade)
  roster            StudentRoster?  @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  term              Term            @relation(fields: [termId], references: [id])
  healthRecords     HealthRecord[]
  homeVisitations   HomeVisitationRecord[]
  admProfiles       AdmLearnerProfile[]
  admMeetings       AdmParentMeeting[]
  counselingSessions CounselingSession[]
  @@index([referredToRole, status])
  @@index([referredToRole, consultReviewer])
  @@index([status])
  @@index([studentId])
  @@index([rosterId])
  @@index([termId])
  // Paginated queue reads filter by term + desk + status together.
  @@index([termId, referredToRole, status])
  @@index([termId, status])
  @@index([termId, referredToRole, consultReviewedAt])
}

// Guidance counseling work on one referral: scheduled talks with the
// student, parents, or a group (plus home visits). A case can only be
// resolved after at least one session is completed — enforced in the
// referrals routes, not just the UI.
model CounselingSession {
  id           String   @id @default(uuid())
  // Exactly one of referralId (adviser-referred case) / interventionId
  // (engine-flagged at-risk follow-up) is set — enforced by a CHECK
  // constraint in the migration. Same session flow on both pipelines.
  referralId   String?
  interventionId String?
  // individual | parent_conference | group | home_visit
  sessionType  String
  scheduledAt  DateTime
  venue        String?
  // scheduled | completed | cancelled
  status       String   @default("scheduled")
  // Written after the session happens.
  sessionNotes String?
  outcome      String?
  cancelReason String?
  createdBy    String
  createdAt   DateTime      @default(now())
  completedAt  DateTime?
  referral     Referral? @relation(fields: [referralId], references: [id], onDelete: Cascade)
  intervention Intervention? @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  creator      User     @relation("SessionCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  attachments  ClinicSessionAttachment[]
  @@index([referralId])
  @@index([interventionId])
  @@index([status])
  @@index([status, scheduledAt])
}

// Documentation filed on one clinic/counseling session: photos (wound,
// referral slip, lab result…) plus the URLs live in object storage — only
// metadata + the public URL are stored here. Filed by the nurse when a
// session is marked done; filing the closing documentation is what finishes
// the case (auto-resolve), so attachments are the case evidence trail.
model ClinicSessionAttachment {
  id         String   @id @default(uuid())
  sessionId  String
  fileUrl    String
  fileName   String
  mimeType   String
  fileSize   Int
  uploadedBy String
  uploadedAt DateTime @default(now())
  session    CounselingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  uploader   User              @relation("SessionAttachmentUploader", fields: [uploadedBy], references: [id], onDelete: Restrict)
  @@index([sessionId])
}

model Intervention {
  id                String          @id @default(uuid())
  // Exactly one of studentId (registered profile) / rosterId (enlisted, no
  // account yet) is set — enforced by a CHECK constraint in the migration.
  studentId         String?
  rosterId          String?
  riskLevelAtFlag   RiskLevel
  recommendedAction String
  assignedTo        String?
  assignedAt        DateTime?
  approvalStatus    ApprovalStatus  @default(pending)
  outcomeStatus     OutcomeStatus   @default(ongoing)
  outcomeNotes      String?
  // Guidance triage when the follow-up starts (same intake as referrals).
  priority          String?
  intakeNotes       String?
  // Filing term — desks never leak follow-ups across terms.
  termId            String
  term              Term            @relation(fields: [termId], references: [id])
  student           StudentProfile? @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  roster            StudentRoster?  @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  assignee          User?           @relation("InterventionAssignee", fields: [assignedTo], references: [id])
  counselingSessions CounselingSession[]
  @@index([rosterId])
  @@index([studentId])
  @@index([termId])
  @@index([outcomeStatus])
  @@index([approvalStatus])
  @@index([assignedTo, outcomeStatus])
  // Stats + queue reads scope counts to the active term.
  @@index([termId, approvalStatus, outcomeStatus])
}
// ---------------------------------------------------------------------------
// 3.6 Specialist modules
// ---------------------------------------------------------------------------
model HealthRecord {
  id                String          @id @default(uuid())
  studentId         String
  referralId        String?
  visitDatetime     DateTime
  complaint          String
  diagnosis          String
  treatmentGiven     String
  recordedBy         String
  termId             String
  confidentialityLevel Confidentiality @default(restricted)
  student            StudentProfile  @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  referral           Referral?       @relation(fields: [referralId], references: [id])
  recorder           User            @relation(fields: [recordedBy], references: [id])
  term               Term            @relation(fields: [termId], references: [id])
}

model HomeVisitationRecord {
  id                String          @id @default(uuid())
  studentId         String
  referralId        String?
  personVisited     String
  homeCondition     String
  familyCondition   String
  agreements        String
  parentSignature   String?
  studentSignature  String?
  certificationBy   String
  termId            String
  confidentialityLevel Confidentiality @default(restricted)
  student           StudentProfile  @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  referral          Referral?       @relation(fields: [referralId], references: [id])
  certifier         User            @relation(fields: [certificationBy], references: [id])
  term              Term            @relation(fields: [termId], references: [id])
}

model AdmLearnerProfile {
  id                  String          @id @default(uuid())
  studentId           String
  referralId          String
  createdAt           DateTime        @default(now())
  eligibilityStatus   AdmEligibility  @default(pending)
  stage               AdmStage        @default(anecdotal)
  preparedBy          String
  approvedBy          String?
  approvedAt          DateTime?
  certificationDetails Json?
  termId              String
  confidentialityLevel Confidentiality @default(restricted)
  student             StudentProfile  @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  referral            Referral        @relation(fields: [referralId], references: [id])
  preparedByUser      User            @relation("AdmPreparedBy", fields: [preparedBy], references: [id])
  approvedByUser      User?           @relation("AdmApprovedBy", fields: [approvedBy], references: [id])
  term                Term            @relation(fields: [termId], references: [id])
  parentMeetings      AdmParentMeeting[]
  modules             AdmModule[]
  devices             AdmDevice[]
  forms               AdmForm[]
  @@index([referralId])
  @@index([studentId])
  @@index([stage])
}
model AdmParentMeeting {
  id                    String             @id @default(uuid())
  // Exactly one side is set (CHECK in the migration): a profile booking, or
  // a pre-profile referral booking. Referral bookings need no student
  // account — the coordinator can schedule the parent meeting the moment a
  // case is referred. They transfer to the learner profile when it is
  // created (see POST /api/adm/profiles).
  admLearnerProfileId   String?
  referralId            String?
  recordedBy            String
  meetingDatetime       DateTime
  // Where the meeting happens: "school" (in-school) or "home" (home
  // visitation). The coordinator books either venue once a case is
  // referred to ADM.
  venue                 String             @default("school")
  attended              Boolean
  parentConfirmedAt     DateTime?
  minutesOfMeeting      String?
  attendanceLogbookRef  String?
  // People present at the meeting, kept by the ADM Coordinator when
  // logging attendance: [{ name, role }]. Roles come from a fixed set
  // (parent/guardian, teacher, student, …) enforced at the API layer.
  attendees             Json                @default("[]")
  admLearnerProfile     AdmLearnerProfile? @relation(fields: [admLearnerProfileId], references: [id], onDelete: Cascade)
  referral              Referral?          @relation(fields: [referralId], references: [id], onDelete: Cascade)
  recorder              User               @relation(fields: [recordedBy], references: [id])
  invitees              AdmMeetingInvitee[]
  attachments           AdmMeetingAttachment[]
  @@index([referralId])
}

// Staff invited to an ADM parent meeting (picked by the ADM Coordinator at
// booking: guidance counselor, nurse, adviser). Invitees get a booking
// notification plus the 5-minute top-center card while the meeting is due.
// Separate from `attendees` (free-text people present, recorded at outcome).
model AdmMeetingInvitee {
  id        String           @id @default(uuid())
  meetingId String
  userId    String
  invitedAt DateTime         @default(now())
  meeting   AdmParentMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([meetingId, userId])
  @@index([userId])
}

// Meeting documentation filed on an ADM parent meeting (photos of the
// signed logbook, venue, agreements…). Mirrors ClinicSessionAttachment:
// images only, capped per meeting, uploaded by the coordinator once the
// meeting is live (or after it was attended).
model AdmMeetingAttachment {
  id         String           @id @default(uuid())
  meetingId  String
  fileUrl    String
  fileName   String
  mimeType   String
  fileSize   Int
  uploadedBy String
  uploadedAt DateTime         @default(now())
  meeting    AdmParentMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  uploader   User             @relation(fields: [uploadedBy], references: [id], onDelete: Restrict)
  @@index([meetingId])
}

model AdmModule {
  id                  String           @id @default(uuid())
  admLearnerProfileId String
  moduleName          String
  releaseDate         DateTime?
  dueDate             DateTime?
  submitted           Boolean          @default(false)
  submissionDate      DateTime?
  recordedBy          String
  admLearnerProfile   AdmLearnerProfile @relation(fields: [admLearnerProfileId], references: [id], onDelete: Cascade)
  recorder            User             @relation(fields: [recordedBy], references: [id])
}

model AdmDevice {
  id                  String           @id @default(uuid())
  admLearnerProfileId String
  deviceType          String
  deviceSerial        String
  issuedBy            String
  issuedDate          DateTime
  returnedDate        DateTime?
  conditionNotes      String?
  admLearnerProfile   AdmLearnerProfile @relation(fields: [admLearnerProfileId], references: [id], onDelete: Cascade)
  issuer              User             @relation("DeviceIssuedBy", fields: [issuedBy], references: [id])
}

model AdmForm {
  id                  String       @id @default(uuid())
  admLearnerProfileId String
  formType            AdmFormType
  title               String
  fileUrl             String?
  status              AdmFormStatus @default(submitted)
  uploadedBy          String
  uploadedAt          DateTime?    @default(now())
  notes               String?
  admLearnerProfile   AdmLearnerProfile @relation(fields: [admLearnerProfileId], references: [id], onDelete: Cascade)
  uploader            User             @relation(fields: [uploadedBy], references: [id])
}

enum AdmFormStatus {
  pending
  submitted
  verified
}


// ---------------------------------------------------------------------------
// 3.7 Records & compliance
// ---------------------------------------------------------------------------
model Sf10Record {
  id                String      @id @default(uuid())
  studentId         String      @unique
  source            Sf10Source
  status            Sf10Status  @default(attach)
  uploadedFileUrl   String?
  ocrExtractedData  Json?
  verifiedBy        String?
  verifiedAt        DateTime?
  validatedBy       String?
  validatedAt       DateTime?
  releasedAt        DateTime?
  archivedAt        DateTime?
  uploadedAt        DateTime?
  updatedAt         DateTime    @updatedAt
  currentVersion    Int         @default(1)
  student           StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  verifiedByUser    User?          @relation("Sf10VerifiedBy", fields: [verifiedBy], references: [id])
  validatedByUser   User?          @relation("Sf10ValidatedBy", fields: [validatedBy], references: [id])
  versions          Sf10RecordVersion[]
}

model Sf10RecordVersion {
  id              String    @id @default(uuid())
  sf10RecordId    String
  versionNumber   Int
  dataSnapshot    Json
  changedBy       String
  changeReason    String
  changedAt       DateTime  @default(now())
  sf10Record      Sf10Record @relation(fields: [sf10RecordId], references: [id], onDelete: Cascade)
  changer         User      @relation(fields: [changedBy], references: [id])
}

model AuditLog {
  id          String    @id @default(uuid())
  userId      String
  actionType  ActionType
  sourceTable String
  sourceId    String
  reason      String?
  oldValue    Json?
  newValue    Json?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
  @@index([sourceTable, sourceId, createdAt])
  @@index([actionType])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model RiskSnapshot {
  id          String    @id @default(uuid())
  // Exactly one of studentId (registered profile) / rosterId (enlisted, no
  // account yet) is set — enforced by a CHECK constraint in the migration.
  studentId   String?
  rosterId    String?
  riskLevel   RiskLevel
  riskLevelRaw RiskLevel?
  riskLevelFinal RiskLevel?
  academicFlag Boolean?
  attendanceFlag Boolean?
  behavioralFlag Boolean?
  academicFlagRaw Boolean?
  attendanceFlagRaw Boolean?
  behavioralFlagRaw Boolean?
  riskCount   Int
  snapshotDate DateTime @default(now())
  termId      String
  student     StudentProfile? @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  roster      StudentRoster? @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  term        Term          @relation(fields: [termId], references: [id])
  @@index([rosterId])
  @@index([studentId])
  @@index([termId, riskLevel])
  @@index([termId, riskLevelRaw])
  @@index([termId, riskLevelFinal])
  @@index([termId, snapshotDate])
  @@index([termId, academicFlag])
  @@index([termId, attendanceFlag])
  @@index([termId, behavioralFlag])
}

model ReportSnapshot {
  id           String    @id @default(uuid())
  reportType   String // trends | intervention_success | heat_map | honor_roll
  scope        String // school | grade | section
  scopeId      String?
  termId       String
  payload      Json
  generatedAt  DateTime  @default(now())
  term         Term      @relation(fields: [termId], references: [id])
}

// Adviser request for extra read access to their advisees' SF10 records (Grade
// 11–12 only). The registrar reviews and approves/denies. Approval grants SF10
// read for the adviser's section advisees via this request row (status gate),
// not by mutating sf10_records.
model AdviserSf10AccessRequest {
  id             String              @id @default(uuid())
  adviserId      String
  sectionId      String
  gradeLevel     GradeLevel
  reason         String
  status         AccessRequestStatus @default(pending)
  decidedBy      String?
  decidedAt      DateTime?
  decisionReason String?
  requestedAt    DateTime            @default(now())
  createdAt      DateTime            @default(now())
  adviser        User                @relation("Sf10AccessAdviser", fields: [adviserId], references: [id], onDelete: Cascade)
  section        Section             @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  decidedByUser  User?               @relation("Sf10AccessDecidedBy", fields: [decidedBy], references: [id])
  @@index([status])
  @@index([adviserId])
  @@index([sectionId])
}

// ---------------------------------------------------------------------------
// 3.8 System
// ---------------------------------------------------------------------------
model Notification {
  id          String        @id @default(uuid())
  userId      String
  type        String // generated by service layer (O7)
  sourceTable String?
  sourceId    String?
  channel     NotifChannel[]
  message     String
  isRead      Boolean       @default(false)
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Notification badge + paged list reads per user.
  @@index([userId, isRead, createdAt])
}

// Operational (not part of the 30 domain tables): refresh token store
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
