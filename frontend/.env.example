# Frontend environment — copy to `.env.local` (git-ignored) for local dev.
# All three are inlined into the client bundle at build time (NEXT_PUBLIC_*),
# so the deploy environment (e.g. Vercel) must define them too — a missing
# value fails at runtime, not at build time.

# Backend API base URL, no trailing slash (e.g. http://localhost:4000 locally).
NEXT_PUBLIC_API_BASE_URL=

# Supabase project URL (public, anon-safe).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key (public, anon-safe; RLS-scoped). Never the service-role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
