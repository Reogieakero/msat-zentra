# Frontend environment — copy to `.env.local` (git-ignored) for local dev.
# All three are inlined into the client bundle at build time (NEXT_PUBLIC_*),
# so the deploy environment (e.g. Vercel) must define them too — a missing
# value fails at runtime, not at build time.

# Backend API base URL, no trailing slash (e.g. http://localhost:4000 locally).
NEXT_PUBLIC_API_BASE_URL=

# Supabase project URL (public, anon-safe).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key (public, anon-safe; RLS-scoped). Never the service-role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Realtime privacy (Phase 3). Set to "true" ONLY after the Supabase project's
# JWT secret is set to match the backend JWT_ACCESS_SECRET and the new anon /
# service-role keys are in place. When "true", the browser authenticates to
# Supabase Realtime with a short-lived backend token so RLS on "Notification"
# can scope delivery to the signed-in user. Leave unset in normal operation.
NEXT_PUBLIC_SUPABASE_REALTIME_AUTH=
